# Golden Scissor — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# OpenRouter API key (required for AI review generation)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model to use (leave blank to use the default free model)
# Examples: openrouter/auto, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=
